# ElastiCon crown-jewel workshop — environment for deploy.py
# cp env.example env.sh, fill in, then:  source env.sh
# env.sh holds secrets: keep it out of any repo, zip or shared folder.

# --- the target cluster (ECH: deployment → Copy endpoint; Serverless: project → Connection details) ---
export ELASTICSEARCH_URL="https://<deployment>.es.<region>.<csp>.elastic-cloud.com"
export KIBANA_URL="https://<deployment>.kb.<region>.<csp>.elastic-cloud.com"
# Admin API key (Kibana → Stack Management → API keys). Kibana accepts the same key.
export ELASTICSEARCH_API_KEY="<base64 api key>"
export KIBANA_API_KEY="$ELASTICSEARCH_API_KEY"

# --- GuardDuty archive in S3 (Lab 3 federation beat) ---
export GD_BUCKET="vgi-guardduty-archive"
export GD_BUCKET_REGION="us-west-2"
# Uploads use your AWS CLI identity; set AWS_PROFILE if it isn't the default.
# export AWS_PROFILE="elasticon"
# Read-only key pair Elasticsearch uses to read the bucket (IAM user <reader-user>, or your own).
export GD_S3_ACCESS_KEY="<reader access key id>"
export GD_S3_SECRET="<reader secret>"

# --- LLMs (defaults are the Serverless / EIS preconfigured ids; see CHECKLIST §1 for ECH) ---
# export LLM_CONNECTOR="Anthropic-Claude-Sonnet-4-5"                             # TARS + MOTHER
# export ALERT_ANALYSIS_CONNECTOR=".anthropic-claude-5-opus-chat_completion"      # Alert analysis

# --- shared clusters (leave unset for a dedicated workshop cluster) ---
# export KIBANA_SPACE="default"          # space id for rules, alerts, entities, agent, workflows, cases
# export VGI_RULES="story"               # only the 26 story rules + custom (default "all": ~700 by data source)
# export VGI_EXCLUDE_NAMESPACES="meridian"   # story rules ignore other teams' data stream namespaces
# export VGI_SKIP_PACKAGES="azure,vsphere"   # Fleet packages not to install (template collisions, unused)

# --- optional ---
# export SEED_WAIT=1500          # seconds deploy.py seed waits for the story rules to fire
